WebDriverWait(driver, 10).until(EC.presence_of_element_located((By.LINK_TEXT, "뉴스"))).click()

from bs4 import BeautifulSoup

html = BeautifulSoup(driver.page_source, 'html.parser')

txt = html.find_all(class_='news_tit')

txt_list = [i.text for i in txt]

for title in txt_list:
    print(title)

