import pandas as pd
import numpy as np
import pymysql
import requests as rq
from io import StringIO
from tqdm import tqdm
import time

# 1. DB 연결 설정
def get_db_conn():
    return pymysql.connect(user="root", passwd="1234", host="127.0.0.1", db="stock_db", charset="utf8")

# 2. 재무제표 클렌징 함수 (영상의 핵심 로직)
def clean_fs(df, ticker, freq):
    df = df.set_index(df.columns[0])
    df = df.replace(['NaN', 'nan', 'N/A'], np.nan)
    df = df.loc[:, df.isnull().sum() < len(df)] # 모든 값이 결측치인 열 제거
    df = df.groupby(level=0).first() # 중복 계정 처리
    
    df_melt = df.reset_index().melt(id_vars=df.columns[0])
    df_melt.columns = ['계정', '기준일', '값']
    df_melt = df_melt.dropna()
    
    # 불필요한 텍스트 제거 및 날짜 변환
    df_melt['계정'] = df_melt['계정'].replace(r'계산에 참여한 계정 펼치기', '', regex=True).str.strip()
    df_melt['기준일'] = pd.to_datetime(df_melt['기준일'], format='%Y/%m') + pd.offsets.MonthEnd(0)
    df_melt['종목코드'] = ticker
    df_melt['공시구분'] = freq
    return df_melt

# 3. 메인 실행 루프
try:
    con = get_db_conn()
    # kor_ticker에서 상장된 종목 리스트 가져오기
    tickers = pd.read_sql("SELECT 종목코드 FROM kor_ticker WHERE 기준일 = (SELECT MAX(기준일) FROM kor_ticker)", con)['종목코드'].tolist()
    con.close()

    print(f"🚀 총 {len(tickers)}개 종목 재무제표 수집 시작...")

    for ticker in tqdm(tickers[:10]): # 우선 테스트로 10개만! 잘 되면 [:10]을 지우세요.
        try:
            url = f"https://comp.fnguide.com/SVO2/ASP/SVD_Finance.asp?pGB=1&gicode=A{ticker}"
            # pd.read_html은 리스트를 반환함
            tables = pd.read_html(url, display_extended_frame=True)
            
            # 연간(0, 2, 4번째 테이블), 분기(1, 3, 5번째 테이블)
            fs_y = pd.concat([tables[0], tables[2], tables[4]])
            fs_q = pd.concat([tables[1], tables[3], tables[5]])
            
            df_y = clean_fs(fs_y, ticker, 'Y')
            df_q = clean_fs(fs_q, ticker, 'Q')
            
            # DB 저장
            con = get_db_conn()
            cur = con.cursor()
            fs_data = pd.concat([df_y, df_q]).values.tolist()
            
            sql = "INSERT IGNORE INTO kor_fs (계정, 기준일, 값, 종목코드, 공시구분) VALUES (%s, %s, %s, %s, %s)"
            cur.executemany(sql, fs_data)
            con.commit()
            con.close()
            
            time.sleep(1) # 서버 차단 방지
            
        except Exception as e:
            print(f"⚠️ {ticker} 수집 중 건너뜀: {e}")
            continue

    print("✨ 재무제표 수집 및 DB 저장 완료!")

except Exception as e:
    print(f"❌ 치명적 에러: {e}")
