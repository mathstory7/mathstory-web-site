import pandas as pd
import numpy as np
import requests as rq
import time
import pymysql
from tqdm import tqdm

# 1. DB 직접 연결 (autocommit으로 안정성 확보)
def get_db_conn():
    return pymysql.connect(
        host='127.0.0.1', user='root', password='1234',
        db='stock_db', charset='utf8', autocommit=True
    )

# 2. 데이터 정제 함수 (MySQL DATE 형식 최적화)
def clean_fs(df, ticker, freq):
    df = df.set_index(df.columns[0])
    df = df.replace(['NaN', 'nan', 'N/A', '', 'None'], np.nan)
    df = df.groupby(level=0).first()
    
    df_melt = df.reset_index().melt(id_vars=df.columns[0])
    df_melt.columns = ['계정', '기준일', '값']
    df_melt = df_melt.dropna()
    
    df_melt['계정'] = df_melt['계정'].astype(str).replace(r'계산에 참여한 계정 펼치기', '', regex=True).str.strip()
    df_melt['기준일'] = pd.to_datetime(df_melt['기준일'].astype(str).str.replace('/', '-'))
    # SQL DATE 포맷인 'YYYY-MM-DD'로 강제 고정
    df_melt['기준일'] = (df_melt['기준일'] + pd.offsets.MonthEnd(0)).dt.strftime('%Y-%m-%d')
    
    df_melt['종목코드'] = ticker
    df_melt['공시구분'] = freq
    return df_melt

# 3. 메인 실행 루프
try:
    conn = get_db_conn()
    
    # [수정] read_sql 대신 cursor 사용으로 에러 원천 차단
    with conn.cursor() as cursor:
        cursor.execute("SELECT 종목코드 FROM kor_ticker WHERE 기준일 = (SELECT MAX(기준일) FROM kor_ticker)")
        tickers = [row[0] for row in cursor.fetchall()]

    print(f"🚀 총 {len(tickers)}개 종목 수집 시작...")

    # 전체 종목을 수집하려면 tickers[:]로 수정하세요. 현재는 테스트용 10개입니다.
    for ticker in tqdm(tickers[:10], desc="재무제표 수집 중"):
        try:
            url = f"https://comp.fnguide.com/SVO2/ASP/SVD_Finance.asp?pGB=1&gicode=A{ticker}"
            tables = pd.read_html(url)
            if len(tables) < 6: continue
            
            fs_total = pd.concat([
                clean_fs(pd.concat([tables[0], tables[2], tables[4]]), ticker, 'Y'),
                clean_fs(pd.concat([tables[1], tables[3], tables[5]]), ticker, 'Q')
            ])

            # 데이터 직접 주입 (INSERT IGNORE로 중복 방지)
            with conn.cursor() as cursor:
                for _, row in fs_total.iterrows():
                    sql = "INSERT IGNORE INTO kor_fs (계정, 기준일, 값, 종목코드, 공시구분) VALUES (%s, %s, %s, %s, %s)"
                    cursor.execute(sql, (row['계정'], row['기준일'], row['값'], row['종목코드'], row['공시구분']))
            
            time.sleep(1) 
        except Exception:
            continue

    print("✨ 재무 수집 완료! 가치 지표(Value) 계산 및 저장을 시작합니다...")

    # [수정] 지표 계산용 데이터 로드 (안정적인 방식)
    fs_data = pd.read_sql("SELECT * FROM kor_fs WHERE 계정 IN ('단기순이익', '자본', '매출액', '영업활동으로인한현금흐름')", conn)
    ticker_data = pd.read_sql("SELECT 종목코드, 종가, 시가총액 FROM kor_ticker WHERE 기준일 = (SELECT MAX(기준일) FROM kor_ticker)", conn)
    
    if not fs_data.empty:
        fs_data = fs_data.sort_values(['종목코드', '계정', '기준일'])
        # TTM 계산 (4분기 합산)
        fs_ttm = fs_data.groupby(['종목코드', '계정'])['값'].rolling(window=4, min_periods=4).sum().reset_index()
        v_data = pd.merge(fs_ttm.groupby(['종목코드', '계정']).tail(1), ticker_data, on='종목코드')
        
        v_data['value'] = (v_data['시가총액'] / 100000000) / v_data['값']
        v_data['지표'] = v_data['계정'].map({'단기순이익':'PER', '자본':'PBR', '매출액':'PSR', '영업활동으로인한현금흐름':'PCR'})
        v_final = v_data[['종목코드', '지표', 'value']].dropna()
        
        # [수정] kor_value 테이블 구조에 맞게 오늘 날짜 추가하여 저장
        with conn.cursor() as cursor:
            for _, row in v_final.iterrows():
                sql = "INSERT IGNORE INTO kor_value (종목코드, 지표, 값, 기준일) VALUES (%s, %s, %s, CURDATE())"
                cursor.execute(sql, (row['종목코드'], row['지표'], row['value']))

    print("🎉 [성공] 모든 데이터가 MySQL 'kor_fs'와 'kor_value'에 저장되었습니다!")
    conn.close()

except Exception as e:
    print(f"❌ 최종 실행 에러: {e}")
