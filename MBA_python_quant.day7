INSERT INTO StoreGoods (store_id, store_name, goods_id, num) VALUES ('000B', '대전', '0006', 60);
INSERT INTO StoreGoods (store_id, store_name, goods_id, num) VALUES ('000B', '대전', '0007', 70);

