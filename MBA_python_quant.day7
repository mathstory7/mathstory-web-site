INSERT INTO StoreGoods (store_id, store_name, goods_id, num) VALUES ('000C', '부산', '0004', 40);
INSERT INTO StoreGoods (store_id, store_name, goods_id, num) VALUES ('000C', '부산', '0006', 60);
INSERT INTO StoreGoods (store_id, store_name, goods_id, num) VALUES ('000C', '부산', '0007', 70);

