import re

data = '동 기업의 매출액은 전년 대비 29.2% 늘어났습니다.'

re.findall('\d+.\d+%', data)
Out[3]: ['29.2%']



import re

p = re.compile('[a-z]+')

type(p)
Out[3]: re.Pattern

m = p.match('python')

m
Out[5]: <re.Match object; span=(0, 6), match='python'>

m.group()
Out[6]: 'python'

print(p.match('Use python'))
None

p.match('PYTHON')

p = re.compile('[A-Z]+')

p.match('PYTHON')
Out[10]: <re.Match object; span=(0, 6), match='PYTHON'>

p = re.compile('[가-힣]+')

m = p.match('파이썬')

m
Out[13]: <re.Match object; span=(0, 3), match='파이썬'>

p = re.compile('[a-z]+')

m = p.search('Use python')

print(m)
<re.Match object; span=(1, 3), match='se'>

p = re.compile('[a-zA-Z]+')

m = p.findall('Life is too short, You need Python.')

print(m)
['Life', 'is', 'too', 'short', 'You', 'need', 'Python']

p = re.compile('[a-zA-Z]+')

m = p.finditer('Life is too short, You need Python.')

print(m)
<callable_iterator object at 0x00000268092AFBB0>

for i in m:
    print(i)
<re.Match object; span=(0, 4), match='Life'>
<re.Match object; span=(5, 7), match='is'>
<re.Match object; span=(8, 11), match='too'>
<re.Match object; span=(12, 17), match='short'>
<re.Match object; span=(19, 22), match='You'>
<re.Match object; span=(23, 27), match='need'>
<re.Match object; span=(28, 34), match='Python'>



num = "\n\t\t15\t\t23\t\t29\n\t\t34\n\t\t40\n\t\t44\n"

import re

p = re.compile('[0-9]+')

m = p.findall(num)

print(m)
['15', '23', '29', '34', '40', '44']

dt = '> 오늘의 날짜는 2022.12.31 입니다.'

p = re.compile('[0-9]+.[0-9]+.[0-9]+')

p.findall(dt)
Out[8]: ['2022.12.31']

p = re.compile('[0-9]+')

m = p.findall(dt)

print(m)
['2022', '12', '31']

''.join(m)
Out[12]: '20221231'

